EVALUATE
ROW(
    "Обращения", [Обращения],
    "В расчёте SLA", [В расчёте SLA],
    "В срок", [В срок],
    "SLA первого ответа", [SLA первого ответа],
    "Нарушения SLA", [Нарушения SLA],
    "Просрочено без ответа", [Просрочено без ответа],
    "Медиана ответа мин", [Медиана ответа мин]
)

EVALUATE
SUMMARIZECOLUMNS(
    'Queues'[Queue],
    'Calendar'[MonthKey],
    "Обращения", [Обращения],
    "В расчёте SLA", [В расчёте SLA],
    "В срок", [В срок],
    "SLA первого ответа", [SLA первого ответа],
    "Нарушения SLA", [Нарушения SLA],
    "Просрочено без ответа", [Просрочено без ответа],
    "Медиана ответа мин", [Медиана ответа мин]
)
ORDER BY 'Queues'[Queue], 'Calendar'[MonthKey]
