table Calendar
	lineageTag: 261a29b0-4d4d-4bc2-9a56-8cfd971025c4

	column Date
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 5b6ef8ee-0a06-4bfd-b829-abf8cd627ff2
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column MonthKey
		dataType: string
		lineageTag: 9974e331-76b4-4adf-aa58-0101ca11a1ba
		summarizeBy: none
		sourceColumn: MonthKey

	partition Calendar = m
		mode: import
		source =
				let
				    Packed = "",
