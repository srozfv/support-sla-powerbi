	partition Tickets = m
		mode: import
		source =
				let
				    Packed = "",
				    Bytes = Binary.Decompress(Binary.FromText(Packed, BinaryEncoding.Base64), Compression.Deflate),
				    Raw = #table({"TicketId", "CreatedAt", "CreatedDate", "QueueId", "PriorityId", "DeadlineAt", "FirstReplyAt", "ReplyMinutes", "Mature", "OnTime", "OpenOverdue"}, Json.Document(Bytes)),
				    Typed = Table.TransformColumnTypes(Raw, {{"TicketId", Int64.Type}, {"CreatedAt", type datetime}, {"CreatedDate", type date}, {"QueueId", Int64.Type}, {"PriorityId", Int64.Type}, {"DeadlineAt", type datetime}, {"FirstReplyAt", type datetime}, {"ReplyMinutes", Int64.Type}, {"Mature", type logical}, {"OnTime", type logical}, {"OpenOverdue", type logical}}, "en-US")
				in
				    Typed

