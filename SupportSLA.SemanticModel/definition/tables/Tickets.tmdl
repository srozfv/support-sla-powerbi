table Tickets
	lineageTag: 7574f57b-58e8-4950-aab6-7f7037f9728b

	measure Обращения = COALESCE(COUNTROWS(Tickets), 0)
		formatString: #,0
		lineageTag: 64fcfdda-b71c-4eb8-9105-0f58cf67e1b9

	measure 'В расчёте SLA' = CALCULATE([Обращения], KEEPFILTERS(Tickets[Mature] = TRUE()))
		formatString: #,0
		lineageTag: 4719acd4-8f1e-439d-ab91-aeb0b187c92a

	measure 'В срок' = CALCULATE([В расчёте SLA], KEEPFILTERS(Tickets[OnTime] = TRUE()))
		formatString: #,0
		lineageTag: e96618c3-0dfe-4520-b058-707a2ff75f2f

	measure 'SLA первого ответа' = DIVIDE([В срок], [В расчёте SLA])
		formatString: 0.0%
		lineageTag: 3d2d5c8b-6ab1-4f84-92c1-1dcc6083c105

	measure 'Нарушения SLA' = [В расчёте SLA] - [В срок]
		formatString: #,0
		lineageTag: c1322260-945d-4221-8bb0-20e24ac9bee5

	measure 'Просрочено без ответа' = CALCULATE([Обращения], KEEPFILTERS(Tickets[OpenOverdue] = TRUE()))
		formatString: #,0
		lineageTag: adcd9200-c5fc-4b89-80a0-717da349dc68

	measure 'Медиана ответа мин' = CALCULATE(MEDIAN(Tickets[ReplyMinutes]), KEEPFILTERS(Tickets[Mature] = TRUE()), KEEPFILTERS(NOT ISBLANK(Tickets[ReplyMinutes])))
		formatString: 0.0
		lineageTag: a642e4b4-726f-457e-82b3-4b2f11088b6a

	column TicketId
